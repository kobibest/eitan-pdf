{
  "name": "pdf-ivrit",
  "version": "1.1.0",
  "description": "תוכנה חינמית ומקומית לעבודה עם PDF בעברית: איחוד, פיצול, סידור, מילוי טפסים וחתימה",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "author": "Kobi Eitan <kobi@eitan-m.co.il>",
  "license": "MIT",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bidi-js": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "PDF עברית",
  "build": {
    "appId": "il.co.eitan-m.pdfivrit",
    "productName": "PDF עברית",
    "artifactName": "PDF-Ivrit-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/web/**",
      "!**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF",
        "description": "מסמך PDF",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "PDF-Ivrit"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "he_IL"
      ],
      "language": "1037",
      "shortcutName": "PDF עברית",
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "PDF-Ivrit-${version}-portable.exe"
    },
    "extraResources": [
      {
        "from": "native/thumbs/dist",
        "to": "native/thumbs",
        "filter": [
          "*.dll",
          "LICENSE*"
        ]
      },
      {
        "from": "native/thumbs/dist-arm64",
        "to": "native/thumbs-arm64",
        "filter": [
          "*.dll",
          "LICENSE*"
        ]
      }
    ]
  }
}